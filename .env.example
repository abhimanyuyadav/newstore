# Generate SESSION_SECRET locally (at least 32 random characters). Never commit real credentials.
SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Hosted deployments: storefront or admin. Omit for combined local development.
APP_SURFACE=
ADMIN_APP_URL=
NEXT_PUBLIC_STOREFRONT_URL=

# Production: deploy convex/ and set the same STORE_SERVER_SECRET in Convex and the Next.js host.
STORE_BACKEND=convex
CONVEX_URL=
STORE_SERVER_SECRET=
# Optional legacy Supabase backend (STORE_BACKEND=supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# For local development only: STORE_BACKEND=local and an optional isolated file.
# STORE_FILE=.data/admin-storage.json

# Both test and production payment modes require explicit merchant configuration.
ESEWA_ENVIRONMENT=test
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
